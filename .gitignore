# Virtual environments
venv/
.venv/

# Python bytecode and caches
__pycache__/
*.pyc
.pytest_cache/

# Environment files
.env
.env.*
!.env.example

# OS metadata
.DS_Store
Thumbs.db

# Runtime logs
*.log
logs/*.log

